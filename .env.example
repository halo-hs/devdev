# SNAP platform backend. The client adds /api/v1/snap automatically.
VITE_SNAP_API_BASE_URL=http://127.0.0.1:8086

# Local development only. Production must provide a Bearer token with
# setSnapAccessTokenProvider() and must not enable these seed actor headers.
VITE_SNAP_ALLOW_DEV_HEADERS=1

# Optional prototype entry points for live backend smoke tests.
VITE_SNAP_DEMO_REPORT_ID=
VITE_SNAP_PUBLIC_TOKEN=
VITE_SNAP_WORKER_TOKEN=
VITE_SNAP_EXTERNAL_UPLOAD_TOKEN=
