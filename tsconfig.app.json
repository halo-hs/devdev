{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@landing/*": [
        "./landing/*"
      ],
      "@auth/*": [
        "./auth/*"
      ],
      "@trade-os/*": [
        "./trade-os/*"
      ],
      "@snap/*": [
        "./snap/*"
      ],
      "@share/*": [
        "./share/*"
      ]
    }
  },
  "include": [
    "src",
    "landing",
    "auth",
    "trade-os",
    "snap",
    "share"
  ]
}
