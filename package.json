{
  "name": "ecoya-devdev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync:design-system": "node scripts/sync-design-system-assets.mjs",
    "predev": "npm run sync:design-system",
    "dev": "vite",
    "prebuild": "npm run sync:design-system",
    "build:ui": "npm --prefix packages/ecoya-ui run build",
    "build": "npm run build:ui && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=devdev --branch=main",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=devdev --branch=repo-migration"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@ecoya/design-system": "*",
    "@ecoya/ui": "*",
    "@fontsource-variable/geist": "^5.2.9",
    "@ibm/plex-sans-kr": "^1.1.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-svgr": "^5.2.0",
    "wrangler": "4.136.1"
  }
}
